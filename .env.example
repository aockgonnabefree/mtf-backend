## PostgreSQL Settings
#POSTGRES_DB=mtf_db
#POSTGRES_USER=admin
#POSTGRES_PASSWORD=1234
#DB_PORT=5433
#
## Application Settings
#APP_DB_URL=jdbc:postgresql://localhost:5433/mtf_db
#APP_DB_USER=admin
#APP_DB_PASSWORD=1234
#SPRING_FLYWAY_ENABLED=true

# ---------------------------
# Database Settings
# ---------------------------
POSTGRES_DB=mtf_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=1234
DB_PORT=5430

# ---------------------------
# Application Settings
# ---------------------------
# สำหรับ run local IDE
APP_DB_URL_LOCAL=jdbc:postgresql://localhost:5430/mtf_db
APP_DB_USER_LOCAL=admin
APP_DB_PASSWORD_LOCAL=1234

# สำหรับ run ใน Docker container
APP_DB_URL_DOCKER=jdbc:postgresql://db:5432/mtf_db
APP_DB_USER_DOCKER=admin
APP_DB_PASSWORD_DOCKER=1234

# Flyway
SPRING_FLYWAY_ENABLED=true

# ---------------------------
# Security Settings
# ---------------------------
# JWT secret key (minimum 256 bits for HS256)
JWT_SECRET=mtf-secret-key-must-be-at-least-256-bits-long-for-security-compliance

# JWT token expiration in milliseconds (24 hours)
JWT_EXPIRATION=86400000

# CORS allowed origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
